        "type": "boolean"
      },
      "magicDnsSuffix": {
        "type": "string",
        "x-tailkeeper-untrusted": true
      },
      "resolvers": {
        "description": "the tailnet's resolvers in preference order; empty means system defaults",
        "items": {
          "type": "string",
          "x-tailkeeper-untrusted": true
        },
        "type": [
          "null",
          "array"
        ],
        "x-tailkeeper-untrusted": true
      },
      "searchDomains": {
        "items": {
          "type": "string",
          "x-tailkeeper-untrusted": true
        },
        "type": [
          "null",
          "array"
        ],
        "x-tailkeeper-untrusted": true
      },
      "selfDnsName": {
        "type": "string",
        "x-tailkeeper-untrusted": true
      },
      "splitDns": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "domain": {
              "type": "string",
              "x-tailkeeper-untrusted": true
            },
            "resolvers": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "address": {
                    "type": "string",
                    "x-tailkeeper-untrusted": true
