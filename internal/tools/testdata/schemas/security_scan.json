{
  "input": {
    "additionalProperties": false,
    "properties": {
      "scope": {
        "description": "fleet: the devices the API lists plus this node's own facts; local: this node only, with no API request. One of fleet, local",
        "type": "string"
      },
      "threshold": {
        "description": "lowest rule severity that counts toward exit 8 and atThreshold: low (default), medium, high or critical; a rule with no severity counts at every threshold",
        "type": "string"
      }
    },
    "required": [
      "scope"
    ],
    "type": "object"
  },
  "output": {
    "additionalProperties": false,
    "properties": {
      "atThreshold": {
        "additionalProperties": false,
        "description": "affected and potentially affected findings at or above the threshold, over all findings, not the listed: any gives exit 8",
        "properties": {
          "affected": {
            "type": "integer"
          },
          "potentiallyAffected": {
            "type": "integer"
          }
        },
        "required": [
          "affected",
          "potentiallyAffected"
        ],
        "type": "object"
      },
      "catalog": {
        "additionalProperties": false,
        "description": "the advisory catalog the scan judged by",
        "properties": {
          "approved": {
            "description": "rules the owner approved",
            "type": "integer"
          },
          "digest": {
            "description": "SHA-256 over the files' name:digest lines; changes with any byte of any file",
            "type": "string"
          },
          "expiresAt": {
            "description": "the earliest expiry of any file: the catalog is stale from then",
            "type": "string"
          },
          "issuedAt": {
            "description": "the latest issue time of any file",
            "type": "string"
          },
          "pending": {
            "description": "rules not yet approved: they give unknown findings only",
            "type": "integer"
          },
          "revision": {
            "description": "the highest revision of any file",
            "minimum": 0,
            "type": "integer"
          },
          "rules": {
            "description": "rules built into this binary: complete and exit 0 are relative to these, and say nothing of advisories the catalog does not hold",
            "type": "integer"
          },
          "withdrawn": {
            "description": "rules withdrawn: they give no finding",
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "issuedAt",
          "expiresAt",
          "digest",
          "rules",
          "approved",
          "pending",
          "withdrawn"
        ],
        "type": "object"
      },
      "counts": {
        "additionalProperties": false,
        "description": "findings by applicability, over all of them",
        "properties": {
          "affected": {
            "type": "integer"
          },
          "notAffected": {
            "type": "integer"
          },
          "potentiallyAffected": {
            "type": "integer"
          },
          "unknown": {
            "type": "integer"
          }
        },
        "required": [
          "affected",
          "potentiallyAffected",
          "unknown",
          "notAffected"
        ],
        "type": "object"
      },
      "coverage": {
        "description": "what each requested dimension covered, and what it did not",
        "items": {
          "additionalProperties": false,
          "properties": {
            "counts": {
              "additionalProperties": false,
              "description": "what a row evaluated; the catalog row has them",
              "properties": {
                "devices": {
                  "type": "integer"
                },
                "findings": {
                  "type": "integer"
                },
                "potentiallyAffected": {
                  "type": "integer"
                },
                "rules": {
                  "type": "integer"
                },
                "unknown": {
                  "type": "integer"
                },
                "withdrawn": {
                  "type": "integer"
                }
              },
              "required": [
                "rules",
                "withdrawn",
                "devices",
                "findings",
                "unknown",
                "potentiallyAffected"
              ],
              "type": [
                "null",
                "object"
              ]
            },
            "dimension": {
              "description": "versions, features, catalog or intent",
              "type": "string"
            },
            "explanation": {
              "description": "why a row is partial or not requested: fixed words, error codes and counts",
              "type": "string"
            },
            "source": {
              "description": "what produced the row",
              "type": "string"
            },
            "status": {
              "description": "complete or partial; not_requested for a dimension not asked for (intent, with no intent set configured), which blocks nothing",
              "type": "string"
            }
          },
          "required": [
            "dimension",
            "source",
            "status"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "findings": {
        "description": "at most 100, affected first",
        "items": {
          "additionalProperties": false,
          "properties": {
            "applicability": {
              "description": "affected, potentially_affected, unknown or not_affected",
              "type": "string"
            },
            "confidence": {
              "description": "unknown or reported",
              "type": "string"
            },
            "device": {
              "description": "the node ID cut to four characters at most, then an ellipsis",
              "type": "string",
              "x-tailkeeper-untrusted": true
            },
            "deviceRef": {
              "description": "a pseudonym of the node ID, the same in every call; needs a privacy key",
              "type": "string"
            },
            "evidence": {
              "description": "the observations the finding cites",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "acquiredAt": {
                    "description": "when tailkeeper read it",
                    "type": "string"
                  },
                  "error": {
                    "description": "why the observation is not usable",
                    "type": "string"
                  },
                  "freshness": {
                    "description": "fresh, stale or unknown",
                    "type": "string"
                  },
                  "observedAt": {
                    "description": "when its source says it was true",
                    "type": "string"
                  },
                  "origin": {
                    "description": "api or local",
                    "type": "string"
                  }
                },
                "required": [
                  "origin",
                  "acquiredAt",
                  "freshness"
                ],
                "type": "object"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "evidenceState": {
              "description": "observed, unknown, stale or absent",
              "type": "string"
            },
            "explanation": {
              "description": "fixed words that say what the finding rests on",
              "type": "string"
            },
            "reason": {
              "description": "why a finding is unknown or only potentially affected, from a fixed set",
              "type": "string"
            },
            "rule": {
              "description": "the advisory rule, for example CVE-2022-41925",
              "type": "string"
            },
            "ruleRevision": {
              "type": "string"
            },
            "severity": {
              "description": "the rule's own severity: unknown, low, medium, high or critical",
              "type": "string"
            },
            "verification": {
              "description": "what the vendor advises, for an affected or potentially affected finding",
              "items": {
                "type": "string"
              },
              "type": [
                "null",
                "array"
              ]
            }
          },
          "required": [
            "rule",
            "ruleRevision",
            "device",
            "applicability",
            "severity",
            "evidenceState",
            "confidence",
            "explanation"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "generatedAt": {
        "description": "when the findings were made: RFC 3339, in UTC",
        "type": "string"
      },
      "intent": {
        "additionalProperties": false,
        "description": "the intent set, by digest; none of its text is in a result",
        "properties": {
          "digest": {
            "description": "keyed digest of the intent file (sha256: with personalData show); none while masked with no privacy key",
            "type": "string"
          },
          "expectations": {
            "description": "tests the file holds; none is judged yet",
            "type": "integer"
          },
          "revision": {
            "description": "the first twelve digits of the digest; none without it",
            "type": "string"
          },
          "source": {
            "description": "none, configured or cli",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "observedAt": {
        "description": "when the sources were read: RFC 3339, in UTC",
        "type": "string"
      },
      "scope": {
        "description": "fleet or local",
        "type": "string"
      },
      "status": {
        "description": "complete or partial. complete: every requested coverage is complete, relative to the shipped catalog (the rules built into this binary, counted in catalog.rules), which is not a statement that the fleet is safe. Pending rules, a failed source or a stale review keep it partial: read coverage",
        "type": "string"
      },
      "threshold": {
        "description": "the severity threshold that applied",
        "type": "string"
      },
      "totalFindings": {
        "description": "every finding the scan made, one for each device and rule; findings lists at most 100",
        "type": "integer"
      },
      "truncated": {
        "description": "findings lists fewer than totalFindings; affected come first, so the cut is the last; no way to page to the rest",
        "type": "boolean"
      }
    },
    "required": [
      "status",
      "scope",
      "threshold",
      "observedAt",
      "generatedAt",
      "totalFindings",
      "truncated",
      "counts",
      "atThreshold",
      "catalog",
      "intent",
      "coverage",
      "findings"
    ],
    "type": "object"
  },
  "tool": "security_scan"
}
