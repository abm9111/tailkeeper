{
  "input": {
    "additionalProperties": false,
    "properties": {
      "allFields": {
        "description": "request fields=all: routes, connectivity, SSH, cloned-state flag",
        "type": "boolean"
      },
      "authorized": {
        "description": "filter on authorized (server-side)",
        "type": [
          "null",
          "boolean"
        ]
      },
      "ephemeral": {
        "description": "filter on isEphemeral (server-side)",
        "type": [
          "null",
          "boolean"
        ]
      },
      "hostname": {
        "description": "exact hostname (server-side); while personal data is masked, refused if it contains an email address or a public IP address",
        "type": "string"
      },
      "nameContains": {
        "description": "case-insensitive substring of name or hostname as the result shows them, where an email or public address is masked while personal data is masked (client-side)",
        "type": "string"
      },
      "online": {
        "description": "filter on connectedToControl (server-side)",
        "type": [
          "null",
          "boolean"
        ]
      },
      "os": {
        "description": "exact OS name, for example linux, macOS, windows (server-side)",
        "type": "string"
      },
      "staleDays": {
        "description": "only devices not connected and last seen more than this many days ago (client-side)",
        "type": "integer"
      },
      "tags": {
        "description": "devices must carry all of these tags (server-side, exact)",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "user": {
        "description": "exact owner login name (server-side); while personal data is masked, only a pseudonym (p:…) or a masked value carrying one, matched client-side, or tagged-devices (server-side)",
        "type": "string"
      }
    },
    "type": "object"
  },
