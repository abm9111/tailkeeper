                "type": "object"
              },
              "type": [
                "null",
                "array"
              ]
            }
          },
          "required": [
            "domain",
            "resolvers"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "systemDnsError": {
        "type": "string",
        "x-tailkeeper-untrusted": true
      },
      "systemNameservers": {
        "items": {
          "type": "string",
          "x-tailkeeper-untrusted": true
        },
        "type": [
          "null",
          "array"
        ],
        "x-tailkeeper-untrusted": true
      },
      "tailscaleDns": {
        "description": "the node accepts the tailnet DNS configuration (--accept-dns)",
        "type": "boolean"
      }
    },
    "required": [
      "tailscaleDns",
      "magicDnsEnabled",
      "resolvers",
      "splitDns",
      "searchDomains",
